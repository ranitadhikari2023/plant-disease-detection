# LeafScan V3 Environment Configuration Template
# Copy to .env and adjust values for your environment. Never commit secrets.

LEAFSCAN_APP_ENV=production
LEAFSCAN_HOST=0.0.0.0
LEAFSCAN_PORT=8000

# CORS (comma-separated origins)
LEAFSCAN_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Model Bundle
LEAFSCAN_MODEL_BUNDLE_PATH=models/bundles/v3
LEAFSCAN_VERIFY_BUNDLE_CHECKSUMS=true
LEAFSCAN_EXECUTION_PROVIDER=CPUExecutionProvider
LEAFSCAN_INTRA_OP_THREADS=2
LEAFSCAN_INTER_OP_THREADS=1

# Concurrency & Rate Limiting
LEAFSCAN_MAX_CONCURRENT_INFERENCES=4
LEAFSCAN_RATE_LIMIT_PER_MINUTE=60
LEAFSCAN_RATE_LIMITING_ENABLED=true

# Defensive Intake Bounds
LEAFSCAN_MAX_UPLOAD_SIZE_BYTES=10485760
LEAFSCAN_MAX_DECODED_PIXELS=40000000
LEAFSCAN_ENABLE_QUALITY_CHECKS=false
LEAFSCAN_BLUR_THRESHOLD=30.0

# Security (Hashed Integrator API Keys)
LEAFSCAN_API_KEY_AUTH_ENABLED=false
LEAFSCAN_AUTHORIZED_API_KEY_HASHES=

# Observability
LEAFSCAN_LOG_LEVEL=INFO
LEAFSCAN_LOG_JSON=true
